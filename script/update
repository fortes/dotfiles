#!/usr/bin/env bash
# Deliberately update user tools; does not relink dotfiles or reconfigure the OS.
# Use apt/Homebrew separately to upgrade system packages and macOS apps.
set -euo pipefail
[[ $# -eq 0 ]] || {
  echo >&2 'Usage: update (no arguments)'
  exit 1
}
# shellcheck source=script/lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

# Match setup's lightweight path, rather than installing the full workstation
# toolset on a devbox that only opted into a few GitHub binaries and language
# servers.
if is_devbox; then
  "${dotfiles_script_dir}/install_github_packages" "${DEVBOX_GITHUB_PACKAGES[@]}"
  npm_packages=("${DEVBOX_NPM_PACKAGES[@]%%:*}")
  npm install --global --loglevel=error --no-fund --no-audit "${npm_packages[@]/%/@latest}"
  exit
fi

"${dotfiles_script_dir}/install_github_packages"
if [[ "$(uname -s)" == Linux ]]; then
  "${dotfiles_script_dir}/install_node"
  "${dotfiles_script_dir}/install_agy"
  # Trixie's ncurses-term only has `ghostty`, not the `xterm-ghostty` Ghostty
  # sets, which tmux needs for its modified keys and true color
  infocmp xterm-ghostty &>/dev/null \
    || tic -x -o "$HOME/.terminfo" "${dotfiles_script_dir}/xterm-ghostty.terminfo"
  # Debian names these fdfind and batcat
  ln -sf /usr/bin/fdfind "$HOME/.local/bin/fd"
  ln -sf /usr/bin/batcat "$HOME/.local/bin/bat"
fi
for step in install_node_packages install_claude_code install_python_packages \
  install_yazi_plugins generate_completions; do
  "${dotfiles_script_dir}/${step}"
done
