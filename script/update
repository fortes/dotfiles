#!/usr/bin/env bash
# Update user tools, not OS packages or links. Keep the host lists short: the
# coding toolchain belongs in dev/setup_container.
set -euo pipefail
[[ $# -eq 0 ]] || {
  echo >&2 'Usage: update (no arguments)'
  exit 1
}
# shellcheck source=script/lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

if is_devbox; then
  exec "${dotfiles_script_dir}/dev/setup_devbox" --upgrade
fi

if [[ "$(uname -s)" == Darwin ]]; then
  "${dotfiles_script_dir}/install_github_packages" gemini-api
  # Media keys for MPD. Python 3.15 breaks its Core Foundation event loop
  # (`_add_reader()` gets an unexpected `context`), so stay on the version
  # it targets
  uv tool install --quiet --force --refresh --python 3.12 mpd-now-playable
else
  # Debian's are missing or too old for git, the shell, init.lua, notes and yazi.
  # Codex, agy and Claude Code are for quick questions on servers too
  "${dotfiles_script_dir}/install_github_packages" bun codex fzf harper-ls \
    marksman neovim tree-sitter-cli uv yazi
  # Debian's nodejs is past upstream end of life
  "${dotfiles_script_dir}/install_node"
  # Formats notes, like Homebrew's on the Mac. Its native binary comes as a
  # regular dependency, so it needs no install scripts
  npm install --global --loglevel=error --no-fund --no-audit --ignore-scripts \
    --min-release-age=3 oxfmt@latest
  # Both update themselves once installed
  "${dotfiles_script_dir}/install_agy"
  if ! command_exists claude; then
    # A throwaway npm cache: nothing else on a host uses npm, and this install
    # would otherwise leave ~500 MB behind
    npm_cache="$(mktemp -d)"
    NPM_CONFIG_CACHE="${npm_cache}" npx --yes --min-release-age=3 @anthropic-ai/claude-code install
    rm -rf "${npm_cache}"
  fi
  # Trixie's ncurses-term only has `ghostty`, not the `xterm-ghostty` Ghostty
  # sets, which tmux needs for its modified keys and true color
  infocmp xterm-ghostty &>/dev/null \
    || tic -x -o "$HOME/.terminfo" "${dotfiles_script_dir}/xterm-ghostty.terminfo"
  # Debian names these fdfind and batcat
  ln -sf /usr/bin/fdfind "$HOME/.local/bin/fd"
  ln -sf /usr/bin/batcat "$HOME/.local/bin/bat"
  if [[ -n "${DOTFILES_DEV_IMAGE:-}" ]]; then
    # IS_DOCKER is true in any container, so the dev image's Dockerfile sets this
    "${dotfiles_script_dir}/dev/setup_container"
  else
    # The homelab's imports use these plugins. macOS uses Homebrew's beets,
    # since its config only needs built-in plugins
    uv tool install --quiet --force --refresh beets --with requests --with pylast \
      --with 'beets[embedart,fetchart,lyrics,lastgenre,plexupdate]'
  fi
fi

"${dotfiles_script_dir}/install_yazi_plugins"
"${dotfiles_script_dir}/generate_completions"
