#!/usr/bin/env bash
# Set up terminal tools and dotfiles on Ubuntu or Debian devboxes/devcontainers that
# already come with a base toolchain: a handful of apt packages, a few GitHub
# binaries, the language servers init.lua enables, and the dotfiles themselves.
# Skips everything in `setup_linux` that changes system config (apt sources,
# podman, locale, login shell, etc).
#
# Safe to run on every boot: each step is a quick no-op when already done.
# Failures are logged immediately and reported after the remaining steps run.
#
# Usage: setup_devbox [--upgrade]
#   --upgrade (run by script/update) only reinstalls the GitHub binaries and
#   language servers at their latest versions

set -euo pipefail
IFS=$'\n\t'

if ! command -v apt-get &>/dev/null; then
  echo >&2 "[dotfiles] Only works on Debian-like systems"
  exit 1
fi

declare dotfiles_root
dotfiles_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

export DEBIAN_FRONTEND=noninteractive
UPGRADE=''

# Names from Debian Trixie and Ubuntu Noble, without pinning to a suite. Older
# releases skip whatever they lack
declare -r DEVBOX_APT_PACKAGES=(
  bat
  ca-certificates
  curl
  fd-find
  git-extras
  git-lfs
  htop
  jq
  moreutils
  ncdu
  ripgrep
  shellcheck
  shfmt
  stow
  tmux
  trash-cli
  unzip
  wget
  zoxide
)

# GitHub binaries, named so their binary is the package name minus any `-cli`.
# Includes delta, since Ubuntu 22.04 (the work devcontainer) has no git-delta
declare -r DEVBOX_GITHUB_PACKAGES=(delta fzf neovim tree-sitter-cli yq)

# Language servers init.lua enables, for the languages devbox repos use, as
# npm package:binary
declare -r DEVBOX_NPM_PACKAGES=(
  bash-language-server:bash-language-server
  dockerfile-language-server-nodejs:docker-langserver
  oxfmt:oxfmt
  oxlint:oxlint
  # TypeScript 7+, whose native `tsc` serves LSP. Projects' own
  # node_modules/.bin/tsc is often older and can't
  typescript:tsc
  vscode-langservers-extracted:vscode-json-language-server
  yaml-language-server:yaml-language-server
)

log() {
  echo "[dotfiles]" "${@}"
}

log_error() {
  echo_stderr "[dotfiles] ${*}"
}

# Run a step, logging failures without aborting the remaining steps. Running
# it as a condition turns off set -e inside, so steps return on failures
# themselves
run_step() {
  "$@" && return 0
  log_error "Step failed, continuing: ${*}"
  return 1
}

# Devcontainers often run as root without sudo installed. Sudo resets the
# environment, so pass DEBIAN_FRONTEND along; sudoers rules that allow only
# some commands without SETENV refuse that
as_root() {
  if [[ ${EUID} -eq 0 ]]; then
    "$@"
  else
    sudo DEBIAN_FRONTEND=noninteractive "$@"
  fi
}

# Print the given apt packages that aren't installed, one per line.
# dpkg-query exits non-zero for unknown names but still lists the rest
missing_apt_packages() {
  local installed package
  installed=" $({ dpkg-query -W -f='${Package}=${db:Status-Status}\n' "$@" 2>/dev/null || true; } \
    | sed -n 's/=installed$//p' | tr '\n' ' ')"
  for package in "$@"; do
    [[ "${installed}" == *" ${package} "* ]] || echo "${package}"
  done
}

install_apt_packages() {
  local missing=()
  mapfile -t missing < <(missing_apt_packages "${DEVBOX_APT_PACKAGES[@]}")

  if [[ ${#missing[@]} -eq 0 ]]; then
    log "Apt packages already installed"
    return
  fi

  local IFS=' '
  # Keep going if a third-party source fails to update
  as_root apt-get update -qq || log_error "apt-get update failed, continuing"

  # One unknown name makes apt-get install nothing at all, so drop the ones
  # this release doesn't have (e.g. eza before Ubuntu 24.04).
  # Single apt-cache call, since each invocation reparses the package index.
  local known available=() unavailable=() package
  known=" $({ apt-cache show "${missing[@]}" 2>/dev/null || true; } \
    | sed -n 's/^Package: //p' | tr '\n' ' ')"
  for package in "${missing[@]}"; do
    if [[ "${known}" == *" ${package} "* ]]; then
      available+=("${package}")
    else
      unavailable+=("${package}")
    fi
  done
  if [[ ${#unavailable[@]} -gt 0 ]]; then
    log "Not available on this release, skipping: ${unavailable[*]}"
  fi
  if [[ ${#available[@]} -eq 0 ]]; then
    return
  fi

  log "Installing apt packages:" "${available[@]}"

  # Waits out a boot-time unattended-upgrades holding the dpkg lock
  as_root apt-get install -qq --assume-yes --no-install-recommends \
    -o=Dpkg::Use-Pty=0 -o=DPkg::Lock::Timeout=120 "${available[@]}"
}

install_github_packages() {
  local missing=() package binary
  for package in "${DEVBOX_GITHUB_PACKAGES[@]}"; do
    case "${package}" in
      neovim) binary=nvim ;;
      *) binary="${package%-cli}" ;;
    esac
    if [[ -n "${UPGRADE}" || ! -x "${HOME}/.local/bin/${binary}" ]]; then
      missing+=("${package}")
    fi
  done

  if [[ ${#missing[@]} -eq 0 ]]; then
    log "GitHub packages already installed"
    return
  fi

  "${dotfiles_root}/script/install_github_packages" "${missing[@]}"
}

install_npm_packages() {
  local missing=() entry
  for entry in "${DEVBOX_NPM_PACKAGES[@]}"; do
    if [[ -n "${UPGRADE}" || ! -x "${HOME}/.local/bin/${entry#*:}" ]]; then
      missing+=("${entry%%:*}")
    fi
  done

  if [[ ${#missing[@]} -eq 0 ]]; then
    log "Npm packages already installed"
    return
  fi

  if ! command_exists npm; then
    log_error "npm not on PATH, can't install: ${missing[*]}"
    return 1
  fi

  log "Installing npm packages:" "${missing[@]}"
  # Explicit cooldown, since devboxes may skip stowing ~/.npmrc
  npm install --global --loglevel=error --no-fund --no-audit --ignore-scripts --min-release-age=3 \
    "${missing[@]/%/@latest}"
}

# Debian and Ubuntu name these fdfind and batcat
link_debian_names() {
  [[ -x /usr/bin/fdfind ]] && ln -sf /usr/bin/fdfind "${HOME}/.local/bin/fd"
  [[ -x /usr/bin/batcat ]] && ln -sf /usr/bin/batcat "${HOME}/.local/bin/bat"
  return 0
}

# Distros with older ncurses lack Ghostty's terminfo, which breaks mouse input
# and escape handling when connecting from Ghostty
install_ghostty_terminfo() {
  if infocmp xterm-ghostty &>/dev/null; then
    return
  fi

  log "Installing Ghostty terminfo into ~/.terminfo"
  tic -x -o "${HOME}/.terminfo" "${dotfiles_root}/script/xterm-ghostty.terminfo"
}

main() {
  # shellcheck source=script/lib.sh
  . "${dotfiles_root}/script/lib.sh"

  case "$*" in
    '') ;;
    --upgrade) UPGRADE=1 ;;
    *)
      log_error "Usage: setup_devbox [--upgrade]"
      return 1
      ;;
  esac

  local failed=0
  if [[ -n "${UPGRADE}" ]]; then
    run_step install_github_packages || failed=1
    run_step install_npm_packages || failed=1
    return "${failed}"
  fi

  run_step install_apt_packages || failed=1
  run_step "${dotfiles_root}/script/stow" -R || failed=1
  run_step install_ghostty_terminfo || failed=1
  run_step install_github_packages || failed=1
  run_step link_debian_names || failed=1
  run_step install_npm_packages || failed=1
  run_step link_debian_names || failed=1

  if [[ ${failed} -ne 0 ]]; then
    log_error "Devbox setup completed with errors"
    return 1
  fi
  log "Devbox setup complete!"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "${@}"
fi
