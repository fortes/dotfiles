#!/usr/bin/env bash
# Install Ollama
#
# Usage: install_ollama [-f|--force]

set -euo pipefail
IFS=$'\n\t'
export DEBIAN_FRONTEND=noninteractive

install_ollama() {
  local force=""
  local install_location="$HOME/.local/bin/ollama"

  while [[ "$#" -gt 0 ]]; do
    case $1 in
      -f | --force) force=true ;;
      *)
        echo >&2 "Unknown parameter passed: $1"
        return 1
        ;;
    esac
    shift
  done

  if [[ -n "${force}" || ! -x "${install_location}" ]]; then
    echo "Installing Ollama..."
    # Not piped into tar: a partial extract leaves an executable bin/ollama,
    # which the -x check above would skip on rerun
    local archive
    archive="$(mktemp)"
    wget --quiet -O "${archive}" "https://ollama.com/download/ollama-linux-amd64.tar.zst"
    tar -C "$HOME/.local" --zstd -xf "${archive}"
    rm -f -- "${archive}"
  fi

  echo "Ollama installed, starting service"
  systemctl --user start ollama

  # Still need to download models, e.g. `ollama run llama3`
  #
  # Can also hook up via `llm` by first `llm install llm-ollama`
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  install_ollama "$@"
fi
