#!/usr/bin/env bash
# Install packages directly from GitHub, for ones Debian doesn't ship or ships
# too old. `--help` lists them.
#
# Usage `install_github_packages [package_names...]`

set -euo pipefail
# So a failure inside `$(...)`, like a bad download in `fetch_asset`, stops the
# script instead of handing back an empty result
shopt -s inherit_errexit
IFS=$'\n\t'
export DEBIAN_FRONTEND=noninteractive

# Token for api.github.com, if one is available
GITHUB_API_TOKEN=''

# What `{ARCH}` in an asset pattern matches, set at startup. Upstreams
# disagree on naming, so each arch covers every spelling in use.
ARCH_PATTERN=''

# Private temp dir for downloads, removed on exit so failed installs don't
# leak temp files. Under ~/.cache rather than /tmp, so it's on the same
# filesystem as the install locations and moving a download into place is a
# rename: an interrupted run can't leave a truncated binary installed.
DOWNLOAD_ROOT=''

AVAILABLE_PACKAGES=(
  bun
  cloudflared
  deno
  difftastic
  f2
  fx
  fzf
  github-cli
  harper-ls
  hugo
  luals
  marksman
  neovim
  sad
  tree-sitter-cli
  yazi
  yq
)

is_available_package() {
  local available
  for available in "${AVAILABLE_PACKAGES[@]}"; do
    [[ "${available}" == "$1" ]] && return 0
  done
  return 1
}

print_usage() {
  echo "Usage: ${0} [-h|--help] [package_names...]"
  echo
  echo "Install packages directly from GitHub. Available packages:"
  echo
  local package
  for package in "${AVAILABLE_PACKAGES[@]}"; do
    echo "- ${package}"
  done
  echo
  echo "Options:"
  echo "-h|--help: Show this message"
}

# One API request per package, against 60/hour per IP unauthenticated or
# 5000 with a token
github_api_token() {
  if [[ -n "${GH_TOKEN:-}" ]]; then
    echo "${GH_TOKEN}"
  elif [[ -n "${GITHUB_TOKEN:-}" ]]; then
    echo "${GITHUB_TOKEN}"
  elif command_exists gh; then
    # Scoped, because a bare `gh auth token` returns the active host's token,
    # and a GitHub Enterprise one is rejected by api.github.com
    gh auth token --hostname github.com 2>/dev/null || true
  fi
}

# The auth header goes in via a config file on stdin, not argv:
# /proc/PID/cmdline is world-readable, so `--header "Authorization: ..."` hands
# the token to any local user for the life of the request. `printf` is a shell
# builtin, so it doesn't land in a process list either.
github_api_get() {
  local url="$1"
  # --fail-with-body keeps GitHub's error JSON for report_api_failure
  local -a args=(--silent --show-error --fail-with-body --retry 3 --retry-connrefused)
  if [[ -n "${GITHUB_API_TOKEN}" ]]; then
    printf 'header = "Authorization: Bearer %s"\n' "${GITHUB_API_TOKEN}" \
      | curl "${args[@]}" --config - "${url}"
  else
    curl "${args[@]}" "${url}"
  fi
}

# Response `$2`, if it's GitHub's error JSON, says why, e.g. "API rate limit
# exceeded" or "Bad credentials"
report_api_failure() {
  local message
  message=$(jq -r '.message // empty' <<<"$2" 2>/dev/null || true)
  echo_stderr "Error: could not fetch the latest release of $1 from the GitHub API${message:+: ${message}}"
  if [[ -z "${GITHUB_API_TOKEN}" ]]; then
    echo_stderr "If rate limited, set GH_TOKEN or run \`gh auth login\` to raise the limit from 60/hour to 5000."
  fi
  exit 2
}

# Prints the URL and GitHub-computed digest, tab-separated, of the first
# asset in the latest release whose URL matches the regex `$2`
get_latest_release_asset() {
  local repo="$1"
  local pattern="${2//\{ARCH\}/${ARCH_PATTERN}}"
  local release_json asset
  release_json=$(github_api_get "https://api.github.com/repos/${repo}/releases/latest") \
    || report_api_failure "${repo}" "${release_json}"

  # jq fails on a non-JSON 200, like a captive portal's page
  asset=$(echo "${release_json}" | jq -r --arg re "${pattern}" \
    'first(.assets[]? | select(.browser_download_url | test($re)))
      | [.browser_download_url, .digest // ""] | @tsv' 2>/dev/null) \
    || report_api_failure "${repo}" ""
  if [[ -z "${asset}" ]]; then
    echo_stderr "Error: Could not find an asset for ${repo} matching ${pattern}"
    echo_stderr "Available assets:"
    echo "${release_json}" | jq -r '.assets[]?.name | "  - " + .' >&2
    exit 2
  fi
  echo "${asset}"
}

# Download the latest release asset of repo `$1` matching `$2`, and print its
# path. It's checked against the sha256 GitHub records at upload, which
# catches corruption and tampering in transit, not a compromised upstream.
# Releases older than mid-2025 have no digest, so those only get a warning.
#
# Each download gets the dir to itself, replacing the last, so install_bin's
# `find` only sees that package.
fetch_asset() {
  local asset url digest file
  # Set at startup, so unset only when the script is sourced. Guards the
  # `rm -rf` below.
  : "${DOWNLOAD_ROOT:?not set, run install_github_packages first}"
  asset="$(get_latest_release_asset "$1" "$2")"
  url="${asset%%$'\t'*}"
  digest="${asset#*$'\t'}"

  rm -rf "${DOWNLOAD_ROOT}/asset"
  mkdir "${DOWNLOAD_ROOT}/asset"
  file="${DOWNLOAD_ROOT}/asset/$(basename "${url}")"
  # stderr, since stdout is the path for the caller
  echo_stderr "Downloading $(basename "${url}") ..."
  wget --quiet -O "${file}" "${url}"

  if [[ "${digest}" != sha256:* ]]; then
    echo_stderr "Warning: no checksum published for $(basename "${url}"), not verified"
  elif ! echo "${digest#sha256:}  ${file}" | sha256sum --check --status -; then
    echo_stderr "Error: checksum mismatch for $(basename "${url}")"
    exit 2
  fi
  echo "${file}"
}

install_executable() {
  local src="$1"
  local dest="$2"
  chmod 755 "${src}"
  mkdir -p "$(dirname "${dest}")"
  mv -f "${src}" "${dest}"
}

# For a whole directory: unpack tarball `$1` beside dir `$2`, and only if the
# new copy has executable `$3`, replace the old one with it, so a bad download
# can't break a working install and files upstream deleted don't linger. Any
# further args go to tar.
unpack_dir() {
  local file="$1"
  local dest="$2"
  local required="$3"
  shift 3
  local staging="${dest}.new"
  rm -rf "${staging}"
  mkdir -p "${staging}"
  if ! tar --no-same-owner -xzf "${file}" -C "${staging}" "$@" \
    || [[ ! -x "${staging}/${required}" ]]; then
    echo_stderr "Error: Could not unpack ${required} from $(basename "${file}")"
    rm -rf "${staging}"
    exit 2
  fi
  rm -rf "${dest}"
  mv "${staging}" "${dest}"
}

# Install executable `$3` (default: the repo name) from a release asset that's
# the bare executable, a .tar.gz, or a .zip
install_bin() {
  local repo="$1"
  local name="${3:-${repo#*/}}"
  local file dir executable
  file="$(fetch_asset "${repo}" "$2")"
  dir="$(dirname "${file}")"

  case "${file}" in
    *.tar.gz) tar --no-same-owner -xzf "${file}" -C "${dir}" ;;
    *.zip) unzip -q "${file}" -d "${dir}" ;;
    *) mv "${file}" "${dir}/${name}" ;;
  esac

  executable="$(find "${dir}" -type f -name "${name}" -print -quit)"
  if [[ -z "${executable}" ]]; then
    echo_stderr "Error: Could not find ${name} in $(basename "${file}"), which has:"
    find "${dir}" -type f >&2
    exit 2
  fi
  install_executable "${executable}" "$HOME/.local/bin/${name}"
  echo "${name} installed"
}

install_deb() {
  local file
  file="$(fetch_asset "$1" "$2")"
  echo "Installing $1 (requires sudo) ... "
  # apt, not `dpkg -i`, so the deb's dependencies resolve. apt reads an
  # argument without a slash as a package name, so it needs the full path.
  sudo apt-get install -qq --assume-yes --no-install-recommends "${file}"
}

install_bun() {
  install_bin 'oven-sh/bun' '/bun-linux-{ARCH}\.zip$'
}

install_cloudflared() {
  install_deb 'cloudflare/cloudflared' '/cloudflared-linux-{ARCH}\.deb$'
}

install_deno() {
  install_bin 'denoland/deno' '/deno-{ARCH}-unknown-linux-gnu\.zip$'
}

install_difftastic() {
  install_bin 'wilfred/difftastic' '/difft-[^/]*{ARCH}-unknown-linux-gnu\.tar\.gz$' 'difft'
}

install_github_cli() {
  install_deb 'cli/cli' '/gh_[^/]*_linux_{ARCH}\.deb$'
}

install_f2() {
  install_deb 'ayoisaiah/f2' '/f2_[^/]*_linux_{ARCH}\.deb$'
}

install_fx() {
  install_bin 'antonmedv/fx' '/fx_linux_{ARCH}$'
}

install_fzf() {
  # Trixie's 0.60 predates `--ghost`, which .fzf-default-options uses
  install_bin 'junegunn/fzf' '/fzf-[^/]*-linux_{ARCH}\.tar\.gz$'
}

install_hugo() {
  # The version is digits and dots, which keeps out `hugo_extended_withdeploy_`
  install_deb 'gohugoio/hugo' '/hugo_extended_[0-9.]*_linux-{ARCH}\.deb$'
}

install_luals() {
  local file
  file="$(fetch_asset 'LuaLS/lua-language-server' '/lua-language-server-[^/]*-linux-{ARCH}\.tar\.gz$')"
  # Run through a symlink, which it resolves to find its own files
  unpack_dir "${file}" "$HOME/.local/share/lua-language-server" bin/lua-language-server
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$HOME/.local/share/lua-language-server/bin/lua-language-server" \
    "$HOME/.local/bin/lua-language-server"
  echo "lua-language-server installed"
}

install_sad() {
  install_deb 'ms-jpq/sad' '/{ARCH}-unknown-linux-gnu\.deb$'
}

install_neovim() {
  local file
  file="$(fetch_asset 'neovim/neovim' '/nvim-linux-{ARCH}\.tar\.gz$')"
  # Straight into ~/.local, so the man page and desktop file land where
  # they're found. Rerun if interrupted
  mkdir -p "$HOME/.local"
  tar --no-same-owner -xzf "${file}" --strip-components=1 -C "$HOME/.local"

  echo "neovim stable installed"
  echo "Run ':lua vim.pack.update()' in Neovim to install plugins"
}

install_marksman() {
  # Must be the glibc build: the musl ones can't run on Debian (no musl
  # loader). init.lua runs it in .NET's invariant mode, so it doesn't need ICU.
  install_bin 'artempyanykh/marksman' '/marksman-linux-{ARCH}$'
}

install_tree_sitter_cli() {
  # Trixie's is too old for nvim-treesitter
  install_bin 'tree-sitter/tree-sitter' '/tree-sitter-cli-linux-{ARCH}\.zip$'
}

install_yazi() {
  local file dir
  file="$(fetch_asset 'sxyazi/yazi' '/yazi-{ARCH}-unknown-linux-gnu\.zip$')"
  dir="$(dirname "${file}")"
  unzip -q -j "${file}" -d "${dir}"

  install_executable "${dir}/ya" "$HOME/.local/bin/ya"
  install_executable "${dir}/yazi" "$HOME/.local/bin/yazi"
  mkdir -p "$HOME/.local/completion.d"
  mv -f "${dir}/ya.bash" "${dir}/yazi.bash" "$HOME/.local/completion.d/"
  echo "yazi installed"
}

install_yq() {
  install_bin 'mikefarah/yq' '/yq_linux_{ARCH}$'
}

install_harper_ls() {
  install_bin 'Automattic/harper' '/harper-ls-{ARCH}-unknown-linux-gnu\.tar\.gz$' 'harper-ls'
}

install_github_packages() {
  # shellcheck source=script/lib.sh
  . "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

  local packages=()

  while (("$#")); do
    case "${1}" in
      -h | --help)
        print_usage
        exit 0
        ;;
      *)
        packages+=("${1}")
        ;;
    esac
    shift
  done

  if [ "${#packages[@]}" -eq 0 ]; then
    packages=("${AVAILABLE_PACKAGES[@]}")
  fi

  # Up front, so a typo doesn't stop the run partway through
  local package
  for package in "${packages[@]}"; do
    if ! is_available_package "${package}"; then
      echo_stderr "Error: Unrecognized package: ${package}"
      exit 1
    fi
  done

  if ! command_exists apt-get; then
    echo_stderr "Only works on Debian-like systems"
    exit 1
  fi

  case "$(uname -m)" in
    x86_64) ARCH_PATTERN='(amd64|x86_64|x64)' ;;
    aarch64) ARCH_PATTERN='(arm64|aarch64)' ;;
    *)
      echo_stderr "Error: Unsupported architecture: $(uname -m)"
      exit 1
      ;;
  esac

  # GH_TOKEN, if set in ~/.profile.local, arrives via the environment:
  # setup_linux sources it, and so does ~/.profile for login shells
  GITHUB_API_TOKEN="$(github_api_token)"

  mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}"
  DOWNLOAD_ROOT="$(mktemp --directory -p "${XDG_CACHE_HOME:-$HOME/.cache}" install_github_packages.XXXXXX)"
  trap 'rm -rf "${DOWNLOAD_ROOT}"' EXIT

  echo -n "Installing GitHub packages:"
  printf " %s" "${packages[@]}"
  echo

  for package in "${packages[@]}"; do
    "install_${package//-/_}"
  done

  echo "GitHub packages installed!"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  install_github_packages "${@}"
fi
