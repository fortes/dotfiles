#!/usr/bin/env bash
# Set up terminal tools and dotfiles on Ubuntu or Debian devboxes/devcontainers that
# already come with a base toolchain: a handful of apt packages, a few GitHub
# binaries, and the dotfiles themselves. Skips everything in `setup_linux` that
# changes system config (apt sources, docker, locale, login shell, etc).
#
# Safe to run on every boot: each step is a quick no-op when already done.
# Failures are logged immediately and reported after the remaining steps run.
#
# Usage: setup_devbox
#
# Set DOTFILES_SKIP_PACKAGES to a space-separated list of stow packages to
# leave alone, e.g. ones whose config the machine already manages.

set -euo pipefail
IFS=$'\n\t'

# Before anything else, since the Bash 4 syntax below fails on macOS Bash 3.2
if ! command -v apt-get &>/dev/null; then
  >&2 echo "[dotfiles] Only works on Debian-like systems"
  exit 1
fi

declare dotfiles_root
dotfiles_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

export DEBIAN_FRONTEND=noninteractive

# Names from Debian Trixie and Ubuntu Noble, without pinning to a suite. Older
# releases skip whatever they lack
declare -r DEVBOX_APT_PACKAGES=(
  bat
  ca-certificates
  curl
  eza
  fd-find
  git-delta
  git-extras
  git-lfs
  htop
  jq
  moreutils
  ncdu
  ripgrep
  shellcheck
  shfmt
  stow
  tmux
  trash-cli
  wget
  zoxide
)

# GitHub package name -> binary it installs into ~/.local/bin
declare -rA DEVBOX_GITHUB_PACKAGES=(
  [fzf]=fzf
  [neovim]=nvim
  [yq]=yq
)

log() {
  echo "[dotfiles] ${*}"
}

log_error() {
  echo_stderr "[dotfiles] ${*}"
}

# Run a step, logging failures without aborting the remaining steps. Running
# it as a condition turns off set -e inside, so steps return on failures
# themselves
run_step() {
  "$@" && return 0
  log_error "Step failed, continuing: ${*}"
  return 1
}

# Devcontainers often run as root without sudo installed. Sudo resets the
# environment, so pass DEBIAN_FRONTEND along; sudoers rules that allow only
# some commands without SETENV refuse that
as_root() {
  if [[ ${EUID} -eq 0 ]]; then
    "$@"
  else
    sudo DEBIAN_FRONTEND=noninteractive "$@"
  fi
}

# Print the given apt packages that aren't installed, one per line.
# dpkg-query exits non-zero for unknown names but still lists the rest
missing_apt_packages() {
  local installed package
  installed=" $({ dpkg-query -W -f='${Package}=${db:Status-Status}\n' "$@" 2>/dev/null || true; } \
    | sed -n 's/=installed$//p' | tr '\n' ' ')"
  for package in "$@"; do
    [[ "${installed}" == *" ${package} "* ]] || echo "${package}"
  done
}

install_apt_packages() {
  local missing=()
  mapfile -t missing < <(missing_apt_packages "${DEVBOX_APT_PACKAGES[@]}")

  if [[ ${#missing[@]} -eq 0 ]]; then
    log "Apt packages already installed"
    return
  fi

  local IFS=' '
  log "Installing apt packages: ${missing[*]}"
  # Keep going if a third-party source fails to update
  as_root apt-get update -qq || log_error "apt-get update failed, continuing"

  # One unknown name makes apt-get install nothing at all, so drop the ones
  # this release doesn't have (e.g. eza and git-delta before Ubuntu 24.04)
  local available=() unavailable=() package
  for package in "${missing[@]}"; do
    if apt-cache show "${package}" &>/dev/null; then
      available+=("${package}")
    else
      unavailable+=("${package}")
    fi
  done
  if [[ ${#unavailable[@]} -gt 0 ]]; then
    log "Not available on this release, skipping: ${unavailable[*]}"
  fi
  if [[ ${#available[@]} -eq 0 ]]; then
    return
  fi

  # Waits out a boot-time unattended-upgrades holding the dpkg lock
  as_root apt-get install -qq --assume-yes --no-install-recommends \
    -o=Dpkg::Use-Pty=0 -o=DPkg::Lock::Timeout=120 "${available[@]}"
}

install_github_packages() {
  local missing=()
  local package
  for package in "${!DEVBOX_GITHUB_PACKAGES[@]}"; do
    # Presence only, so these never upgrade
    if [[ ! -x "${HOME}/.local/bin/${DEVBOX_GITHUB_PACKAGES[${package}]}" ]]; then
      missing+=("${package}")
    fi
  done

  if [[ ${#missing[@]} -eq 0 ]]; then
    log "GitHub packages already installed"
    return
  fi

  "${dotfiles_root}/script/install_github_packages" "${missing[@]}"
}

# Distros with older ncurses lack Ghostty's terminfo, which breaks mouse input
# and escape handling when connecting from Ghostty
install_ghostty_terminfo() {
  if infocmp xterm-ghostty &>/dev/null; then
    return
  fi

  log "Installing Ghostty terminfo into ~/.terminfo"
  tic -x -o "${HOME}/.terminfo" "${dotfiles_root}/script/xterm-ghostty.terminfo"
}

# Try all packages in one stow first, since that's a single quick call on every
# boot. If a pre-existing file conflicts, fall back to stowing one package at a
# time so the conflict only skips that package.
stow_packages() {
  if ! command_exists stow; then
    log_error "stow not installed, skipping dotfiles"
    return 1
  fi

  if [[ -n "${DOTFILES_SKIP_PACKAGES:-}" ]]; then
    log "Skipping DOTFILES_SKIP_PACKAGES: ${DOTFILES_SKIP_PACKAGES}"
  fi

  if stow_with_backup; then
    log "Dotfiles stowed"
    return
  fi
  log_error "Could not stow all packages together, retrying one at a time"

  local packages=()
  mapfile -t packages < <(list_stow_packages "${dotfiles_root}/stowed-files")

  local failed=0
  local package
  for package in "${packages[@]}"; do
    if ! stow_with_backup "${package}"; then
      log_error "Could not stow ${package} (conflicting files?), try: script/stow -n -v ${package}"
      failed=1
    fi
  done

  if [[ ${failed} -ne 0 ]]; then
    return 1
  fi
  log "Dotfiles stowed"
}

# Keep machine-specific edits to tracked *.local files (like ~/.gitconfig.local)
# from dirtying the checkout and blocking `git pull`
lock_local_files() {
  (cd "${dotfiles_root}" && "${dotfiles_root}/script/lock_local_files" >/dev/null)
}

main() {
  # shellcheck source=script/lib.sh
  . "${dotfiles_root}/script/lib.sh"

  if [[ $# -gt 0 ]]; then
    log_error "Usage: setup_devbox (takes no arguments)"
    return 1
  fi

  local failed=0 step
  for step in ensure_local_profile install_apt_packages install_github_packages \
    install_ghostty_terminfo stow_packages lock_local_files; do
    run_step "${step}" || failed=1
  done

  if [[ ${failed} -ne 0 ]]; then
    log_error "Devbox setup completed with errors"
    return 1
  fi
  log "Devbox setup complete!"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "${@}"
fi
