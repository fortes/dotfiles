#!/usr/bin/env bash
# Generate bash completion files for various tools
#
# Usage: generate_completions

set -euo pipefail
IFS=$'\n\t'

# shellcheck source=script/lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

generate_completions() {
  declare -r completion_dir="$HOME/.local/completion.d"
  declare -r man_dir_path="$HOME/.local/share/man/man1"
  mkdir -p "${completion_dir}"
  mkdir -p "${man_dir_path}"

  echo -n "… Generating completions & man pages"

  if command_exists beet; then
    # The first `beet` invocation after a schema change prints one-time DB
    # migration notices ("Created database backup at: …") on stdout, which end
    # up inside the completion file and make every new shell emit
    # `Created: command not found`. Those lines parse as valid bash, so a
    # syntax check won't catch them -- warm up first so the notices land here
    # instead of in the generated file.
    beet version >/dev/null 2>&1 || true
    # beets only looks for bash-completion in fixed paths that don't include
    # Homebrew's, so it warns on every Mac. Drop just that line; with pipefail,
    # a failing `beet` still fails here
    { beet completion 2>&1 >&3 \
      | { grep -v 'Unable to find the bash-completion package' || true; } >&2; } \
      3>"${completion_dir}/beet_completion"
  fi

  if command_exists bun; then
    SHELL=bash bun completions "${completion_dir}" >"${completion_dir}/bun.completion.bash"
  fi

  if command_exists codex; then
    codex completion bash >"${completion_dir}/codex.completion.bash"
  fi

  if command_exists container; then
    container --generate-completion-script bash >"${completion_dir}/container.completion.bash"
  fi

  if command_exists delta; then
    delta --generate-completion bash >"${completion_dir}/delta_completion"
  fi

  if command_exists gh; then
    gh completion -s bash >"${completion_dir}/gh_completion"
  fi

  if command_exists hugo; then
    hugo completion bash >"${completion_dir}/hugo_completion"
    hugo gen man --dir "${man_dir_path}" >/dev/null
  fi

  if command_exists npm; then
    npm completion >"${completion_dir}/npm_completion"
  fi

  if command_exists op; then
    op completion bash >"${completion_dir}/op_completion"
  fi

  if command_exists uv; then
    uv generate-shell-completion bash >"${completion_dir}/uv_completion"
  fi

  # Debian/Ubuntu ship a Python `yq` wrapper around jq that lacks `shell-completion`
  if command_exists yq && [[ "$(yq --version 2>/dev/null)" == *mikefarah* ]]; then
    yq shell-completion bash >"${completion_dir}/yq_completion"
  fi

  echo -e "\r\033[K✓ Completions generated"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  generate_completions "${@}"
fi
