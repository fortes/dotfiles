#!/usr/bin/env bash
# Install the latest Node.js release from nodejs.org into ~/.local, checking
# the tarball against the release's SHASUMS256.txt
#
# Usage: install_node

set -euo pipefail
IFS=$'\n\t'

# shellcheck source=script/lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

DIST_URL="https://nodejs.org/dist"
INSTALL_ROOT="${HOME}/.local/lib/nodejs"
BIN_DIR="${HOME}/.local/bin"
# Retry transient failures, and abort connections or transfers that stall
CURL_ARGS=(
  --silent
  --show-error
  --fail
  --retry 3
  --connect-timeout 15
  --speed-limit 1024
  --speed-time 30
)
node_arch() {
  case "$(uname -m)" in
    x86_64) echo "x64" ;;
    aarch64 | arm64) echo "arm64" ;;
    *)
      echo >&2 "⨯ Unsupported architecture: $(uname -m)"
      exit 1
      ;;
  esac
}

major() {
  local version="${1#v}"
  echo "${version%%.*}"
}

# Download and verify before extracting. Interrupted installs can be rerun.
download_release() {
  local version="$1" dist="$2"
  curl "${CURL_ARGS[@]}" --output "${INSTALL_ROOT}/SHASUMS256.txt" \
    "${DIST_URL}/${version}/SHASUMS256.txt"
  curl "${CURL_ARGS[@]}" --output "${INSTALL_ROOT}/${dist}.tar.gz" \
    "${DIST_URL}/${version}/${dist}.tar.gz"
  (
    cd "${INSTALL_ROOT}"
    awk -v file="${dist}.tar.gz" '$2 == file' SHASUMS256.txt | sha256sum --check --status
  ) || {
    echo >&2 "⨯ Checksum mismatch for ${dist}.tar.gz"
    exit 1
  }
  tar --extract --gzip --no-same-owner \
    --file "${INSTALL_ROOT}/${dist}.tar.gz" --directory "${INSTALL_ROOT}"
  "${INSTALL_ROOT}/${dist}/bin/node" --version >/dev/null
  rm "${INSTALL_ROOT}/SHASUMS256.txt" "${INSTALL_ROOT}/${dist}.tar.gz"
}

install_node() {
  if [[ "$#" -gt 0 ]]; then
    echo >&2 "Usage: $(basename "$0")"
    exit 1
  fi

  if [[ "$(uname -s)" != "Linux" ]]; then
    echo >&2 "⨯ install_node is for Linux; use Homebrew on macOS"
    exit 1
  fi

  mkdir --parents "${INSTALL_ROOT}" "${BIN_DIR}"

  local arch current version
  arch="$(node_arch)"
  current="$("${INSTALL_ROOT}/current/bin/node" --version 2>/dev/null || true)"
  version="$(curl "${CURL_ARGS[@]}" "${DIST_URL}/index.json" | jq --raw-output '.[0].version')"
  if [[ ! "${version}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo >&2 "⨯ Unexpected Node version in release index: ${version}"
    exit 1
  fi

  local dist="node-${version}-linux-${arch}"
  if [[ "${version}" == "${current}" ]]; then
    echo "✓ Node ${version} already installed"
  else
    echo "Installing Node ${version} …"
    download_release "${version}" "${dist}"
    echo "✓ Node ${version} installed"
  fi

  ln --symbolic --force --no-dereference "${dist}" "${INSTALL_ROOT}/current"
  local command
  for command in node npm npx; do
    ln --symbolic --force "${INSTALL_ROOT}/current/bin/${command}" "${BIN_DIR}/${command}"
  done

  # Remove older versions
  local old
  for old in "${INSTALL_ROOT}"/node-v*; do
    if [[ -e "${old}" && "${old##*/}" != "${dist}" ]]; then
      rm --recursive --force -- "${old}"
    fi
  done

  # npm globals' native addons are built for one major version. Without a
  # previous install, the globals' Node version is unknown, so rebuild them too
  if [[ "$(major "${current:-v0}")" != "$(major "${version}")" ]]; then
    "$(dirname "${BASH_SOURCE[0]}")/install_node_packages" --rebuild
  fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  install_node "${@}"
fi
