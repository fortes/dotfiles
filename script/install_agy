#!/usr/bin/env bash
# Install the auto-updating Antigravity CLI on Debian; macOS uses Homebrew.
set -euo pipefail
# shellcheck source=script/lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
command_exists apt-get || {
  echo >&2 'install_agy is Linux-only'
  exit 1
}
[[ ! -x "$HOME/.local/bin/agy" ]] || exit 0

case "$(uname -m)" in
  x86_64 | amd64) arch=amd64 ;;
  arm64 | aarch64) arch=arm64 ;;
  *)
    echo >&2 "Unsupported architecture: $(uname -m)"
    exit 1
    ;;
esac
base_url='https://antigravity-cli-auto-updater-974169037036.us-central1.run.app'
manifest="$(curl -fsSL "${base_url}/manifests/linux_${arch}.json")"
version="$(jq -r '.version' <<<"${manifest}")"
url="$(jq -er '.url' <<<"${manifest}")"
sha512="$(jq -er '.sha512' <<<"${manifest}")"

echo "Installing agy ${version} ..."
cache="$HOME/.cache/antigravity"
mkdir -p "${cache}" "$HOME/.local/bin"
curl -fsSL -o "${cache}/release" "${url}"
[[ "$(sha512sum "${cache}/release" | cut -d' ' -f1)" == "${sha512}" ]] \
  || {
    echo >&2 'Checksum mismatch for agy'
    exit 1
  }
if [[ "${url}" == *.tar.gz* ]]; then
  tar -xzf "${cache}/release" -C "${cache}" antigravity
  cp "${cache}/antigravity" "$HOME/.local/bin/agy"
  rm "${cache}/antigravity"
else
  cp "${cache}/release" "$HOME/.local/bin/agy"
fi
rm "${cache}/release"
chmod 755 "$HOME/.local/bin/agy"
"$HOME/.local/bin/agy" install || true
echo 'agy installed!'
