#!/usr/bin/env bash
#
# cleanup_disk - Free up disk space by cleaning up package manager caches, etc
#
# Usage:
#   cleanup_disk [OPTIONS]
#
# Options:
#   --volumes     Also prune unused container volumes (Docker/Podman)
#   -h, --help    Show help message
set -euo pipefail
IFS=$'\n\t'

PRUNE_VOLUMES=0

usage() {
  cat <<EOF
Usage: $(basename "$0") [OPTIONS]

Free up disk space by cleaning up package manager caches, etc

Options:
  --volumes     Also prune unused container volumes (Docker/Podman)
  -h, --help    Show this help message

Examples:
  $(basename "$0")            # Run cache cleanup
  $(basename "$0") --volumes  # Also prune container volumes
  $(basename "$0") -h         # Show help

EOF
}

cleanup_apt() {
  if command -v apt >/dev/null 2>&1; then
    echo "Cleaning up APT (requires sudo)..."
    sudo apt autoremove -y
    sudo apt autoclean
    sudo apt clean
  fi
}

cleanup_brew() {
  if command -v brew >/dev/null 2>&1; then
    echo "Cleaning up Homebrew..."
    brew cleanup --prune=all
    brew autoremove
  fi
}

cleanup_docker() {
  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    echo "Cleaning up Docker..."
    docker system prune -af
    if [[ "${PRUNE_VOLUMES}" -eq 1 ]]; then
      echo "Pruning Docker volumes..."
      docker volume prune -af
    fi
  fi
}

cleanup_podman() {
  if command -v podman >/dev/null 2>&1 && podman info >/dev/null 2>&1; then
    echo "Cleaning up Podman..."
    if [[ "${PRUNE_VOLUMES}" -eq 1 ]]; then
      echo "Pruning Podman volumes..."
      podman system prune -af --volumes
    else
      podman system prune -af
    fi
  fi
}

cleanup_bun() {
  if command -v bun >/dev/null 2>&1; then
    echo "Cleaning up bun cache..."
    bun pm cache rm 2>/dev/null || true
  fi
}

cleanup_npx() {
  if command -v npx >/dev/null 2>&1; then
    echo "Cleaning up npx cache..."
    npx clear-npx-cache 2>/dev/null || true
  fi
}

cleanup_pnpm() {
  if command -v pnpm >/dev/null 2>&1; then
    echo "Cleaning up pnpm store..."
    pnpm store prune
  fi
}

cleanup_pip() {
  if command -v pip >/dev/null 2>&1; then
    echo "Cleaning up pip cache..."
    pip cache purge 2>/dev/null || true
  fi
}

cleanup_uv() {
  if command -v uv >/dev/null 2>&1; then
    echo "Cleaning up uv cache..."
    uv cache clean
  fi
}

main() {
  echo "Running system cleanup..."

  cleanup_apt
  cleanup_brew
  cleanup_docker
  cleanup_podman
  cleanup_bun
  cleanup_npx
  cleanup_pnpm
  cleanup_pip
  cleanup_uv
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --volumes)
      PRUNE_VOLUMES=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "Error: Unknown option $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

main
