#!/usr/bin/env bash
# Call stow with correct paths for dotfiles
#
# Should be able to run with `-R` to delete stale files, otherwise can do
# `find -L ~/.config -type l [-delete]` to find/remove stale links
#
# Usage: stow [-n] [-v] [-D | -R] [package ...]
#
# Stows every package when none are given, minus any listed in the
# space-separated DOTFILES_SKIP_PACKAGES. Stowing `bash` backs up existing
# default startup files into ~/.dotfiles-backup.*. For other stow options, call
# stow directly.

set -euo pipefail
IFS=$'\n\t'

# Directories that programs write into (keys, binaries, plugins, units), so
# they must stay real instead of getting folded into a symlink into the repo.
# Stow never folds a directory that already exists, so create them before
# stowing. Dry runs skip this and the startup-file backup, so `-n` may show
# folds or conflicts a real run won't hit
declare -r REAL_DIRS=(
  .ssh
  .config/cmus
  .config/tmux
  .config/systemd/user
  .config/yazi
  .local/bin
  .local/share
)

# Files provided by Debian, macOS, or devbox images that conflict with the
# bash package
declare -r DEFAULT_DOTFILES=(.bashrc .profile .bash_profile .hushlogin)

# Whether a stow package is listed in the space-separated
# DOTFILES_SKIP_PACKAGES. Only applies when stowing everything: packages named
# explicitly get stowed anyway
is_skipped_package() {
  [[ " ${DOTFILES_SKIP_PACKAGES:-} " == *" $1 "* ]]
}

list_stow_packages() {
  local package_path package
  for package_path in "$1"/*/; do
    [[ -d "${package_path}" ]] || continue
    package="$(basename "${package_path}")"
    is_skipped_package "${package}" || echo "${package}"
  done
}

# Whether a startup file in $HOME is machine-provided and would block stow:
# a regular file, or a symlink that doesn't point into a stowed-files dir
is_default_dotfile() {
  local -r path="${HOME}/$1"
  if [[ -L "${path}" ]]; then
    [[ "$(readlink "${path}")" != *stowed-files/* ]]
  else
    [[ -f "${path}" ]]
  fi
}

# Back up machine-provided startup files before stowing. If stow fails,
# fix the conflict and rerun, or restore the files from the printed directory.
backup_default_dotfiles() {
  local filename backup_dir=''
  for filename in "${DEFAULT_DOTFILES[@]}"; do
    is_default_dotfile "${filename}" || continue
    if [[ -z "${backup_dir}" ]]; then
      backup_dir="$(mktemp -d "$HOME/.dotfiles-backup.XXXXXX")" || return 1
      echo "Startup-file backup: ${backup_dir} (restore manually if needed)"
    fi
    mv "$HOME/${filename}" "${backup_dir}/original${filename}" || return 1
  done
}

main() {
  local dotfiles_root
  dotfiles_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  local stowed_files_path="${dotfiles_root}/stowed-files"

  # shellcheck source=script/lib.sh
  . "${dotfiles_root}/script/lib.sh"

  if ! command_exists stow; then
    echo_stderr "Error: stow command not found. Please install GNU Stow first."
    return 1
  fi

  if [[ ! -d "${stowed_files_path}" ]]; then
    echo_stderr "Warning: stowed-files directory not found at ${stowed_files_path}, skipping stow"
    return 0
  fi

  local options=() packages=() action="" simulate=0 arg package
  for arg in "$@"; do
    case "${arg}" in
      -n) simulate=1 ;;
      -v) ;;
      -D | -R)
        if [[ -n "${action}" ]]; then
          echo_stderr "Error: pass only one of -D or -R."
          return 1
        fi
        action="${arg}"
        ;;
      -*)
        echo_stderr "Error: unsupported option ${arg}; call stow directly."
        return 1
        ;;
      *)
        packages+=("${arg}")
        continue
        ;;
    esac
    options+=("${arg}")
  done

  if [[ ${#packages[@]} -eq 0 ]]; then
    # No mapfile, since macOS ships Bash 3.2
    while IFS= read -r package; do
      packages+=("${package}")
    done < <(list_stow_packages "${stowed_files_path}")
    if [[ ${#packages[@]} -eq 0 ]]; then
      echo_stderr "Warning: no packages found in ${stowed_files_path}, nothing to stow"
      return 0
    fi
  fi

  if [[ "${action}" == -D ]]; then
    # Otherwise a partial delete can refold a writable directory into a
    # remaining package
    options+=(--no-folding)
  elif [[ ${simulate} -eq 0 ]]; then
    for package in "${packages[@]}"; do
      if [[ "${package}" == bash ]]; then
        backup_default_dotfiles
        break
      fi
    done

    local dir
    for dir in "${REAL_DIRS[@]}"; do
      dir="${HOME}/${dir}"
      [[ -e "${dir}" || -L "${dir}" ]] && continue
      mkdir -p "${dir}"
      # Private, since it holds keys
      if [[ "${dir}" == "${HOME}/.ssh" ]]; then
        chmod 700 "${dir}"
      fi
    done
  fi

  stow --dir="${stowed_files_path}/" --target="${HOME}" \
    ${options[@]+"${options[@]}"} "${packages[@]}"
}

# Bash 3.2 treats an empty "$@" as unset under `set -u`
main ${@+"$@"}
