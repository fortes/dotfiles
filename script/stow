#!/usr/bin/env bash
# Call stow with correct paths for dotfiles
#
# Usage: stow [-n] [-v] [-D | -R] [package ...]
#
# Stows all packages (minus DOTFILES_SKIP_PACKAGES) with --no-folding, backs up
# machine-provided startup files, then copies missing local-templates/<package>/
# files into $HOME. For other stow options, call stow directly.

set -euo pipefail
IFS=$'\n\t'

# Files provided by Debian, macOS, or devbox images that conflict with the
# bash package
declare -r DEFAULT_DOTFILES=(.bashrc .profile .bash_profile .hushlogin)

# Copy each file under template dir $1 to the same path in $HOME, unless
# something is there. Private, since the copies hold secrets
copy_local_templates() {
  local templates="$1" file
  [[ -d "${templates}" ]] || return 0
  while IFS= read -r file; do
    file="${file#"${templates}/"}"
    [[ -e "${HOME}/${file}" || -L "${HOME}/${file}" ]] && continue
    mkdir -p "$(dirname "${HOME}/${file}")"
    (umask 077 && cp "${templates}/${file}" "${HOME}/${file}")
    echo "Copied ${file} into ~; fill in its REPLACE_MEs"
  done < <(find "${templates}" -type f)
}

# Whether $1 is among the remaining arguments
is_listed() {
  local needle="$1" item
  shift
  for item in "$@"; do
    [[ "${item}" == "${needle}" ]] && return 0
  done
  return 1
}

# Whether a startup file in $HOME is machine-provided and would block stow:
# a regular file, or a symlink that doesn't point into a stowed-files dir
is_default_dotfile() {
  local -r path="${HOME}/$1"
  if [[ -L "${path}" ]]; then
    [[ "$(readlink "${path}")" != *stowed-files/* ]]
  else
    [[ -f "${path}" ]]
  fi
}

# Back up machine-provided startup files before stowing. If stow fails,
# fix the conflict and rerun, or restore the files from the printed directory.
backup_default_dotfiles() {
  local filename backup_dir=''
  for filename in "${DEFAULT_DOTFILES[@]}"; do
    is_default_dotfile "${filename}" || continue
    if [[ -z "${backup_dir}" ]]; then
      backup_dir="$(mktemp -d "$HOME/.dotfiles-backup.XXXXXX")" || return 1
      echo "Startup-file backup: ${backup_dir} (restore manually if needed)"
    fi
    mv "$HOME/${filename}" "${backup_dir}/original${filename}" || return 1
  done
}

main() {
  local dotfiles_root
  dotfiles_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  local stowed_files_path="${dotfiles_root}/stowed-files"

  # shellcheck source=script/lib.sh
  . "${dotfiles_root}/script/lib.sh"

  # Otherwise the startup-file backup moves .bashrc and friends aside, then dies
  if ! command_exists stow; then
    echo_stderr "Error: stow command not found. Please install GNU Stow first."
    return 1
  fi

  local options=() packages=() action="" simulate=0 arg package
  for arg in "$@"; do
    case "${arg}" in
      -n) simulate=1 ;;
      -v) ;;
      -D | -R) action="${arg}" ;;
      -*)
        echo_stderr "Error: unsupported option ${arg}; call stow directly."
        return 1
        ;;
      *)
        packages+=("${arg}")
        continue
        ;;
    esac
    options+=("${arg}")
  done

  if [[ ${#packages[@]} -eq 0 ]]; then
    # DOTFILES_SKIP_PACKAGES only applies here: named packages get stowed anyway
    for package in "${stowed_files_path}"/*/; do
      package="$(basename "${package}")"
      [[ " ${DOTFILES_SKIP_PACKAGES:-} " == *" ${package} "* ]] || packages+=("${package}")
    done
  fi

  options+=(--no-folding)
  if [[ "${action}" != -D && ${simulate} -eq 0 ]]; then
    if is_listed bash "${packages[@]}"; then
      backup_default_dotfiles
    fi
    if is_listed ssh "${packages[@]}"; then
      # Holds keys, so create it private before stow does
      [[ -d "${HOME}/.ssh" ]] || mkdir -m 700 "${HOME}/.ssh"
    fi
  fi

  stow --dir="${stowed_files_path}/" --target="${HOME}" \
    ${options[@]+"${options[@]}"} "${packages[@]}"

  if [[ "${action}" != -D && ${simulate} -eq 0 ]]; then
    for package in "${packages[@]}"; do
      copy_local_templates "${dotfiles_root}/local-templates/${package}"
    done
  fi
}

# Bash 3.2 treats an empty "$@" as unset under `set -u`
main ${@+"$@"}
