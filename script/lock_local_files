#!/usr/bin/env bash
# Keep machine-specific .local edits, and configs holding credentials, out of
# git status.
set -euo pipefail
cd "$(dirname "$0")/.."
git rev-parse --is-inside-work-tree &>/dev/null || exit 0
# To unlock one: git update-index --no-skip-worktree <file>
git ls-files -z '*.local' '*/.mpdscribble/mpdscribble.conf' | xargs -0 -r git update-index --skip-worktree
