#!/usr/bin/env bash
# Keep machine-specific .local edits out of git status.
set -euo pipefail
cd "$(dirname "$0")/.."
git rev-parse --is-inside-work-tree &>/dev/null || exit 0
# To unlock one: git update-index --no-skip-worktree <file>
git ls-files -z '*.local' | xargs -0 -r git update-index --skip-worktree
