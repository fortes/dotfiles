#!/usr/bin/env bash
# Make your machine usable
#
# Usage: setup_linux

set -euo pipefail
IFS=$'\n\t'

declare dotfiles_root
dotfiles_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# shellcheck source=script/lib.sh
. "${dotfiles_root}/script/lib.sh"

# Make sure not to get stuck on any prompts
export DEBIAN_FRONTEND=noninteractive

# Common apt-get arguments
declare -r APT_ARGS=(
  -qq
  -o=Dpkg::Use-Pty=0
  -o=Dpkg::Progress-Fancy=0
  -o=APT::Get::Show-Progress=false
  --assume-yes
  --fix-broken
  --no-install-recommends
)

declare -r APT_PACKAGES_FILE="${dotfiles_root}/script/apt-packages.txt"
declare -a APT_PACKAGES
mapfile -t APT_PACKAGES < <(awk 'NF && $1 !~ /^#/' "${APT_PACKAGES_FILE}")

check_prerequisites() {
  if ! command_exists apt-get; then
    echo_stderr "Only works on Debian-like systems"
    return 1
  fi

  # shellcheck source=/dev/null
  . /etc/os-release
  if [[ "${ID}" != debian ]]; then
    echo_stderr "Warning: Things might break outside of Debian"
  fi
}

install_apt_packages() {
  if [[ -n "${SKIP_INITIAL_APT_INSTALL:-}" ]]; then
    echo "Skipping apt package installation (SKIP_INITIAL_APT_INSTALL set)"
    return
  fi

  local -a packages=("${APT_PACKAGES[@]}")
  # Crostini is already a container, on a modest machine. Include rootless
  # recommends skipped by --no-install-recommends (networking, UID mapping,
  # user bus, and an init for pods and --init)
  if [[ -z "${IS_DOCKER:-}" ]] && ! compgen -G "/etc/apt/sources.list.d/cros.*" >/dev/null; then
    packages+=(podman passt uidmap dbus-user-session catatonit)
  fi

  echo "Running apt-get update (requires sudo)"
  sudo -E apt-get update -qq

  echo "Ensuring apt packages installed (requires sudo)"
  sudo -E apt-get install "${APT_ARGS[@]}" "${packages[@]}"
  echo "Apt packages installed"
}

setup_backports() {
  declare -r sources_path="/etc/apt/sources.list.d/backports.sources"

  if [[ -f "$sources_path" ]]; then
    echo "Backports already in sources.list"
    return
  fi

  echo "${VERSION_CODENAME}-backports not in sources.list, adding (requires sudo)"
  sudo tee "$sources_path" >/dev/null <<EOF
Types: deb
URIs: http://deb.debian.org/debian
Suites: ${VERSION_CODENAME}-backports
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
EOF
}

setup_locale() {
  declare -r locale="en_US.UTF-8"

  # Check generated locales rather than $LANG, which SSH may forward from the client
  if ! locale -a 2>/dev/null | grep -qi '^en_us\.utf-\?8$'; then
    echo "Generating locale ${locale} (requires sudo)"
    sudo sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
    sudo locale-gen
  fi
  sudo update-locale "LANG=${locale}"
}

setup_nonfree() {
  declare -r deb822_path="/etc/apt/sources.list.d/debian.sources"

  if [[ ! -f "$deb822_path" ]]; then
    echo_stderr "No debian sources found, skipping non-free setup"
    return
  fi

  # Match standalone `non-free`, not the default `non-free-firmware`
  if grep -qE '(^|[[:space:]])non-free([[:space:]]|$)' "$deb822_path"; then
    echo "Non-free already in ${deb822_path}"
    return
  fi

  echo "Adding contrib & non-free to ${deb822_path} (requires sudo)"
  sudo sed -i -E 's/^Components: main([[:space:]].*)?$/Components: main contrib non-free non-free-firmware/' \
    "$deb822_path"
}

setup_shell() {
  local user bash_path current_shell
  user="$(id -un)"
  bash_path="$(command -v bash)"
  current_shell="$(getent passwd "${user}" | awk -F : '{print $NF}')"

  # Merged /usr means /bin/bash and /usr/bin/bash are the same file
  if [[ ! "${current_shell}" -ef "${bash_path}" ]]; then
    echo "Changing shell to bash (requires sudo)"
    sudo chsh -s "${bash_path}" "${user}"
  fi
}

main() {
  [[ $# -eq 0 ]] || {
    echo >&2 'Usage: setup_linux (no arguments)'
    return 1
  }

  check_prerequisites
  setup_shell

  "${dotfiles_root}/script/set_dotfiles_remote"

  setup_nonfree
  setup_backports
  install_apt_packages
  "${dotfiles_root}/script/install_1password"
  [[ -z "${IS_DOCKER:-}" ]] && "${dotfiles_root}/script/install_et"
  "${dotfiles_root}/script/stow" -R

  "${dotfiles_root}/script/lock_local_files"
  setup_locale

  "${dotfiles_root}/script/update"

  echo "Setup complete!"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "${@}"
fi
