#!/usr/bin/env bash
# Set up an Apple Silicon Mac.

set -euo pipefail
IFS=$'\n\t'

if [[ "$(uname -m)" != "arm64" ]]; then
  echo >&2 "⨯ This dotfiles setup only supports Apple Silicon Macs."
  echo >&2 "  Detected architecture: $(uname -m)"
  exit 1
fi

declare -r brew_prefix="/opt/homebrew"
# Homebrew 7 defaults to "ask mode", which blocks on a confirmation prompt
# whenever the install plan includes dependencies
export HOMEBREW_NO_ASK=1
declare dotfiles_root
dotfiles_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

BREW_PACKAGES=(
  bash
  bash-completion@2
  bat
  oven-sh/bun/bun
  chafa
  cloudflared
  # Docker fallback for projects that need it, alongside podman
  colima
  container
  delta
  difftastic
  docker
  docker-compose
  duf
  MisterTea/et/et
  eza
  f2
  fd
  # For yazi
  ffmpeg
  fx
  fzf
  gh
  git
  git-crypt
  git-extras
  git-lfs
  gnupg
  gron
  harper
  htop
  hugo
  iftop
  # For yazi
  imagemagick
  jq
  keychain
  lua-language-server
  marksman
  moreutils
  mpc
  mpd
  mpdscribble
  mpv
  music-decoy
  ncdu
  neovim
  node
  pipx
  # For :Obsidian paste_img
  pngpaste
  podman
  ripgrep
  rmpc
  rust
  sad
  # For yazi
  sevenzip
  shellcheck
  shfmt
  speedtest-cli
  stow
  tmux
  tree-sitter-cli
  wget
  yazi
  yq
  yt-dlp
  zoxide
)

# Only casks that brew keeps updated. Apps that update themselves are installed
# by hand instead (see README), since brew loses track of their versions
CASK_PACKAGES=(
  1password-cli
  font-google-sans-code
  font-jetbrains-mono
  # For yazi
  font-symbols-only-nerd-font
)

setup_shell() {
  local homebrew_bash_path="${brew_prefix}/bin/bash"

  if [[ -x "${homebrew_bash_path}" ]] && [[ "${SHELL:-}" != "${homebrew_bash_path}" ]]; then
    if ! grep -qxF "${homebrew_bash_path}" /etc/shells; then
      echo "Adding ${homebrew_bash_path} to shell list (requires sudo)"
      echo "${homebrew_bash_path}" | sudo tee -a /etc/shells >/dev/null
    fi

    # Only change shell if running interactively, otherwise fails in CI which
    # can't do the required auth
    if [[ -t 1 ]]; then
      echo "Changing shell to bash ($homebrew_bash_path)"
      chsh -s "${homebrew_bash_path}"
    fi
  fi
}

setup_homebrew() {
  # Homebrew's installer also installs Xcode Command Line Tools when missing
  if [[ ! -x "${brew_prefix}/bin/brew" ]]; then
    echo "Installing Homebrew"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install.sh)"
  fi

  if [[ ! -f "$HOME/.profile.brew" ]]; then
    echo "Exporting brew shellenv"
    "${brew_prefix}/bin/brew" shellenv >"$HOME/.profile.brew"
  fi

  # Ensure `brew` in path for rest of script
  # shellcheck source=/dev/null
  . "$HOME/.profile.brew"

  echo "Installing homebrew packages"
  "${brew_prefix}/bin/brew" install --quiet "${BREW_PACKAGES[@]}"

  echo "Installing homebrew casks"
  "${brew_prefix}/bin/brew" install --cask --quiet "${CASK_PACKAGES[@]}"
}

# Lets media keys control MPD. Written here rather than stowed, since launchd
# needs absolute paths
setup_mpd_now_playable() {
  local -r label="local.mpd-now-playable"
  local -r plist="$HOME/Library/LaunchAgents/${label}.plist"
  mkdir -p "$HOME/Library/LaunchAgents"
  cat >"${plist}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${label}</string>
  <key>ProgramArguments</key>
  <array>
    <string>$HOME/.local/bin/mpd-now-playable</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <!-- Exits when MPD isn't up yet, so keep retrying -->
  <key>KeepAlive</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>$HOME/Library/Logs/mpd-now-playable.log</string>
</dict>
</plist>
EOF
}

main() {
  # shellcheck source=script/lib.sh
  . "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

  [[ $# -eq 0 ]] || {
    echo >&2 'Usage: setup_mac (no arguments)'
    return 1
  }

  setup_homebrew

  "${dotfiles_root}/script/stow" -R

  setup_shell

  "${dotfiles_root}/script/lock_local_files"
  "${dotfiles_root}/script/set_dotfiles_remote"

  "${dotfiles_root}/script/update"

  setup_mpd_now_playable

  echo "Setup complete!"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main ${@+"$@"}
fi
