#!/usr/bin/env bash
# Install python packages via `uv`
#
# Usage: install_python_packages

set -euo pipefail
IFS=$'\n\t'

# shellcheck source=script/lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

UVX_PACKAGES=(
  argcomplete
  # Requires additional dependencies due to plugins
  "beets --with requests --with pylast --with beets[embedart,fetchart,lyrics,lastgenre,plexupdate]"
  epy-reader
  files-to-prompt
  llm
  # `pynvim`, not the `neovim` alias: PyPI calls that a transition package, and
  # depending on it pins an old pynvim. Neovim 0.12+ finds it automatically
  # without needing `g:python3_host_prog`.
  pynvim
  pyright
  ruff
  streamdown
)

install_python_packages() {
  if ! command_exists pipx; then
    >&2 echo "⨯ pipx not installed!"
    exit 1
  fi

  if ! command_exists uv; then
    >&2 echo "⨯ uv not installed, installing"
    pipx install --quiet --force uv
  fi

  echo "Installing global uvx packages …"
  for package in "${UVX_PACKAGES[@]}"; do
    # Use eval to properly handle quoted arguments and multiple flags
    # shellcheck disable=SC2086
    eval "uv tool install --quiet --force --refresh ${package}"
  done
  echo "uvx packages installed!"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  install_python_packages "${@}"
fi
