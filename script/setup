#!/usr/bin/env bash
# Bootstrap an environment, be it Linux or Mac
#
# Ubuntu, used by Coder devboxes and most devcontainers, gets the lightweight,
# repeatable setup_devbox. Set DOTFILES_DEVBOX=1 for it anywhere else, e.g. a
# Debian devcontainer

# Get script directory
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=script/lib.sh
. "${script_dir}/lib.sh"

if is_devbox; then
  exec "${script_dir}/setup_devbox" "$@"
elif uname -s | grep -q Darwin; then
  exec "${script_dir}/setup_mac" "$@"
elif command -v apt >/dev/null 2>&1; then
  exec "${script_dir}/setup_linux" "$@"
else
  echo >&2 'Unsupported OS'
  exit 1
fi
