#!/usr/bin/env bash
# Bootstrap an environment, be it Linux or Mac
#
# Ubuntu, used by Coder devboxes and most devcontainers, gets the lightweight,
# repeatable setup_devbox. Set DOTFILES_DEVBOX=1 for it anywhere else, e.g. a
# Debian devcontainer

set -euo pipefail

# shellcheck source=script/lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

if [[ "$(uname -s)" == Darwin ]]; then
  exec "${dotfiles_script_dir}/setup_mac" ${@+"$@"}
elif is_devbox; then
  exec "${dotfiles_script_dir}/setup_devbox" ${@+"$@"}
elif command_exists apt-get; then
  exec "${dotfiles_script_dir}/setup_linux" ${@+"$@"}
else
  echo_stderr 'Unsupported OS'
  exit 1
fi
