#!/usr/bin/env bash
# Install global npm packages
#
# Usage: install_node_packages

set -euo pipefail
IFS=$'\n\t'
NPM_PACKAGES=(
  @openai/codex
  @playwright/mcp
  agent-browser
  bash-language-server
  corepack
  dockerfile-language-server-nodejs
  oxfmt
  oxlint
  tsx
  typescript
  vscode-langservers-extracted
  yaml-language-server
)

# shellcheck source=script/lib.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib.sh"

require_node() {
  if ! command_exists node || ! command_exists npm; then
    echo >&2 "⨯ Node.js and npm must be on PATH (install via brew or script/install_node)"
    exit 1
  fi
}

install_node_packages() {
  [[ $# -eq 0 ]] || {
    echo >&2 'Usage: install_node_packages (no arguments)'
    return 1
  }

  # lib.sh supplies installer paths, including Homebrew before stow.
  require_node

  echo "Using Node $(node --version)"

  # None needs its install scripts (Codex's and oxfmt's native binaries are
  # dependencies, and agent-browser's launcher links its own on first run),
  # which also leaves no native addons to rebuild after Node major upgrades
  echo "Installing global npm packages …"
  npm install --global --loglevel=error --no-fund --no-audit --ignore-scripts \
    "${NPM_PACKAGES[@]/%/@latest}"
  echo "Npm packages installed!"

  # Keep project package-manager shims in the user prefix across Node
  # upgrades. Leave npm itself supplied by Node/Homebrew.
  echo "Enabling pnpm and Yarn via Corepack …"
  "$HOME/.local/bin/corepack" enable --install-directory "$HOME/.local/bin" pnpm yarn
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  install_node_packages "${@}"
fi
