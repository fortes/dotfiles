# Colors for `ls`, eza and readline's completion lists, from the terminal's
# palette so they match Ghostty's theme (see ghostty/themes): 31 red, 32
# green, 33 yellow, 34 blue, 35 magenta, 36 cyan, 38;5;8 comment gray.
# Attributes: 01 bold, 02 dim, 05 blink. `dircolors -p` lists the rest

# Terminals that get colors at all
TERM *color*
TERM Eterm
TERM alacritty
TERM ansi
TERM con[0-9]*x[0-9]*
TERM cons25
TERM console
TERM cygwin
TERM dtterm
TERM gnome
TERM hurd
TERM jfbterm
TERM konsole
TERM kterm
TERM linux
TERM linux-c
TERM mlterm
TERM putty
TERM rxvt*
TERM screen*
TERM st
TERM terminator
TERM tmux*
TERM vt100
TERM xterm*

RESET 0
DIR 01;36
# Same color as the target
LINK target
# Broken symlinks
ORPHAN 01;05;31
MISSING 01;05;31
FIFO 33
SOCK 35
BLK 33
CHR 33
SETUID 30;41
SETGID 30;43
# World-writable directories
STICKY_OTHER_WRITABLE 30;42
OTHER_WRITABLE 30;42
STICKY 30;44
EXEC 01;32

# Not a file type: readline's `colored-completion-prefix` uses it for the part
# of each completion that's already typed (magenta otherwise)
*readline-colored-completion-prefix 02

# Build files and READMEs, styled like eza does them so `ls` and completion
# match (the names eza picks out). These match the end of a name and `ls`
# ignores case, so `ls` also styles e.g. `makefile`, which completion doesn't
*BUILD.bazel 01;04;33
*Brewfile 01;04;33
*CMakeLists.txt 01;04;33
*Cargo.toml 01;04;33
*Containerfile 01;04;33
*Dockerfile 01;04;33
*Gemfile 01;04;33
*Justfile 01;04;33
*Makefile 01;04;33
*PKGBUILD 01;04;33
*Pipfile 01;04;33
*Podfile 01;04;33
*Procfile 01;04;33
*README 01;04;33
*README.md 01;04;33
*Rakefile 01;04;33
*SConstruct 01;04;33
*Vagrantfile 01;04;33
*WORKSPACE 01;04;33
*build.gradle 01;04;33
*build.ninja 01;04;33
*composer.json 01;04;33
*flake.nix 01;04;33
*meson.build 01;04;33
*package.json 01;04;33
*pom.xml 01;04;33
*pyproject.toml 01;04;33
*readme.txt 01;04;33
*tsconfig.json 01;04;33

# Leftovers
*~ 38;5;8
.bak 38;5;8
.log 38;5;8
.swp 38;5;8
.tmp 38;5;8
