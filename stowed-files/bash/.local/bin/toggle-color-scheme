#!/usr/bin/env bash
# Swap color scheme between light and dark in `tmux`
#
# Usage: toggle-color-scheme [light|dark]
set -euo pipefail

declare dir_path
dir_path="$(dirname "${BASH_SOURCE[0]}")"

main() {
  local new_theme
  new_theme="${1:-}"

  if [[ -z "${new_theme}" ]]; then
    local current_theme
    current_theme="$(get_current_color_theme)"

    if [[ "${current_theme}" == "light" ]]; then
      new_theme="dark"
    else
      new_theme="light"
    fi
  elif [[ "${new_theme}" != "light" && "${new_theme}" != "dark" ]]; then
    echo "Error: Invalid theme. Use 'light' or 'dark'." >&2
    exit 1
  fi

  echo -n "Setting color scheme to ${new_theme}..."

  local script_target
  script_target="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}" 2>/dev/null || true)"
  local dotfiles_root
  dotfiles_root="$(cd "$(dirname "${script_target}")/../../../.." 2>/dev/null && pwd || true)"
  if [[ -z "${dotfiles_root}" || ! -d "${dotfiles_root}/script" ]]; then
    dotfiles_root="${HOME}/dotfiles"
  fi

  # Colorscheme scripts have unbound variables
  set +u
  if [[ "${new_theme}" == "light" ]]; then
    # shellcheck source=../../../../script/base16-default-light.sh
    . "${dotfiles_root}/script/base16-default-light.sh"
  else
    # shellcheck source=../../../../script/base16-default-dark.sh
    . "${dotfiles_root}/script/base16-default-dark.sh"
  fi
  set -u

  update_tmux_colors "${new_theme}"
  update_cmus_colors "${new_theme}"
  update_neovim_colors "${new_theme}"

  echo "done!"
}

get_current_color_theme() {
  if tmux has-session >/dev/null 2>&1; then
    local tmux_value
    tmux_value="$(tmux show-environment -g COLOR_THEME 2>/dev/null || true)"
    if [[ -n "${tmux_value}" ]]; then
      echo "${tmux_value}" | cut -d= -f2-
      return
    fi
  fi

  if [[ -n "${COLOR_THEME:-}" ]]; then
    echo "${COLOR_THEME}"
    return
  fi

  # Get terminal background color and extract red channel
  local red_bg_value
  red_bg_value=$("${dir_path}/get-terminal-background-color" | cut -d: -f2)

  # Look at the first digit of the red value, and assume anything more than
  # half is light, and anything less is dark
  if [[ "${red_bg_value:0:1}" =~ [8-9A-Fa-f] ]]; then
    echo "light"
  else
    echo "dark"
  fi
}

# Check if cmus is running and update its colors if so
update_cmus_colors() {
  local new_theme
  new_theme="${1:-}"

  if pgrep -x cmus >/dev/null; then
    if [[ "${new_theme}" == "light" ]]; then
      cmus-remote -C "colorscheme xterm-white"
    else
      cmus-remote -C "colorscheme spotify"
    fi
  fi
}

# Check if neovim is running and update its colors if so
update_neovim_colors() {
  local new_theme
  local sockets_output

  new_theme="${1:-}"

  if ! command -v nvim >/dev/null 2>&1; then
    return
  fi

  sockets_output="$("${dir_path}/list-nvim-sockets" 2>/dev/null || true)"

  if [[ -z "${sockets_output}" ]]; then
    return
  fi

  local socket
  local background
  local colorscheme

  if [[ "${new_theme}" == "light" ]]; then
    background="light"
    colorscheme="base16-default-light"
  else
    background="dark"
    colorscheme="base16-default-dark"
  fi

  while IFS= read -r socket; do
    [[ -S "${socket}" ]] || continue
    nvim --server "${socket}" --remote-send "<Esc>:set background=${background}|colorscheme ${colorscheme}<cr>"
  done <<<"${sockets_output}"
}

# Usage: update_tmux_server THEME TMUX_COMMAND...
update_tmux_server() {
  local new_theme session
  new_theme="${1:-}"
  shift

  # Skip servers that aren't running
  if ! "$@" has-session 2>/dev/null; then
    return
  fi

  # Set the theme globally and drop any per-session copy (left by older
  # versions of this script), which would shadow the global value
  "$@" set-environment -g COLOR_THEME "${new_theme}" || return 0
  while IFS= read -r session; do
    "$@" set-environment -t "${session}" -u COLOR_THEME
  done < <("$@" list-sessions -F '#{session_id}')

  # No client to refresh when targeting the main server from the console
  "$@" source-file ~/.config/tmux/tmux.conf &&
    "$@" refresh-client -S 2>/dev/null ||
    true
}

update_tmux_colors() {
  local new_theme
  new_theme="${1:-}"

  # Inside the console popup, TMUX points at the console server, so reach the
  # main server through the default socket instead
  if [[ "${TMUX:-}" == */console,* ]]; then
    update_tmux_server "${new_theme}" env -u TMUX tmux
  else
    update_tmux_server "${new_theme}" tmux
  fi

  # The console popup runs on its own long-lived server (see tmux.conf), which
  # can outlive the main one, so update it too, otherwise new shells there keep
  # the old theme
  update_tmux_server "${new_theme}" tmux -L console
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
