#!/bin/bash
#
# Get the background color of the terminal
# Requires a terminal that supports the OSC 11 escape sequence
# Output examples:
#
# - rgb:1111/1111/1111
#
# Usage: get-terminal-background-color

set -euo pipefail

main() {
  if [[ ${TERM} == "linux" ]]; then
    # Escape codes not supported in Linux console, just return black for now
    echo "rgb:0000/0000/0000"
    return
  fi

  # Open a new file descriptor for the terminal
  exec 3<> /dev/tty

  # Disable terminal echoing
  stty -echo <&3

  # Send the escape sequence to query the background color
  printf '\e]11;?\a' >&3

  # Bound the query and restore echo even when the terminal does not answer.
  local status=0
  IFS=$'\a' read -t 2 -d $'\a' -r -u 3 response || status=$?
  stty echo <&3
  exec 3<&-
  [[ ${status} -eq 0 ]] || return 1

  # Remove everything up to and including '<ESC>]11;'
  color=${response#*$'\e]11;'}

  # Remove any trailing characters after the color value
  echo "${color%%$'\a'*}"
}

main
