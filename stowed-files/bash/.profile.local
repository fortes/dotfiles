# Machine-specific settings, sourced last by ~/.profile. Edits stay local:
# script/lock_local_files marks this file skip-worktree.

# Affects bash prompt, which hides unless this is the username
# export DEFAULT_USERNAME=ffortes

# Raises install_github_packages' GitHub API limit (else it asks gh)
# export GH_TOKEN="REPLACE_ME"

# Used for 'llm'
# export ANTHROPIC_API_KEY="REPLACE_ME"
# export GEMINI_API_KEY="REPLACE_ME"
# export LLM_GEMINI_KEY="${GEMINI_API_KEY}"
# export LLM_MISTRAL_KEY="REPLACE_ME"
# export OPENAI_API_KEY="REPLACE_ME"
# export OPENROUTER_API_KEY="REPLACE_ME"

# Typescript language server can OOM on large codebases
# export MAX_TS_SERVER_MEMORY=32768
# Same, but for eslint and others
# export NODE_OPTIONS='--max_old_space_size=16384'

# Add machine-specific items below
# export BEETSDIR=/data/media/music/beets
