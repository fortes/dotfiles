#!/usr/bin/env bash
#
# Display current track information if cmus is playing

set -euo pipefail
IFS=$'\n\t'

# Make sure to load `command_exists` helper
# shellcheck source=/dev/null
. ~/.profile

cmus_status() {
  local cmus_status
  cmus_status=$(cmus-remote -Q 2>&1 || echo)
  if echo "${cmus_status}" | grep -qi "not running"; then
    return
  fi

  local artist
  local title
  local album
  local albumArtist

  # A missing tag must not abort the script (set -e + pipefail), so tolerate no
  # match and treat the tag as empty
  artist=$(echo "${cmus_status}" | grep -i '^tag artist ' | cut -d ' ' -f 3- || true)
  title=$(echo "${cmus_status}" | grep -i '^tag title ' | cut -d ' ' -f 3- || true)
  album=$(echo "${cmus_status}" | grep -i '^tag album ' | cut -d ' ' -f 3- || true)
  albumArtist=$(echo "${cmus_status}" | grep -i '^tag albumartist ' | cut -d ' ' -f 3- || true)

  # Nothing to show (e.g. a file with no tags): stay blank rather than print a
  # bare separator
  if [ -z "${artist}${title}${albumArtist}${album}" ]; then
    return
  fi

  if echo "${cmus_status}" | grep -qi "status playing"; then
    echo "${artist} ▸ ${title}  "
  else
    echo "${albumArtist} ♪ ${album}  "
  fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  if command_exists cmus-remote; then
    cmus_status "${@}"
  fi
fi
