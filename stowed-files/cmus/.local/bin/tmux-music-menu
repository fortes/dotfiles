#!/usr/bin/env bash
#
# Tmux menu for controlling cmus or MPD. `tmux-music-menu toggle` just
# plays/pauses

set -euo pipefail
IFS=$'\n\t'

# shellcheck source=tmux-music-status
source "$(dirname "${BASH_SOURCE[0]}")/tmux-music-status"

player_command() {
  local player="${1}"
  local action="${2}"

  if [[ "${player}" == "cmus" ]]; then
    case "${action}" in
      previous) echo "cmus-remote --prev" ;;
      toggle) echo "cmus-remote --pause" ;;
      stop) echo "cmus-remote --stop" ;;
      next) echo "cmus-remote --next" ;;
    esac
  else
    case "${action}" in
      previous) echo "mpc -q prev" ;;
      toggle) echo "mpc -q toggle" ;;
      stop) echo "mpc -q stop" ;;
      next) echo "mpc -q next" ;;
    esac
  fi
}

music_menu() {
  local player
  player=$(active_player)
  if [[ -z "${player}" ]]; then
    tmux display-message "Not playing music"
    return
  fi

  if [[ "${1:-}" == "toggle" ]]; then
    eval "$(player_command "${player}" toggle)"
    return
  fi

  local status
  local verb
  status=$(player_status "${player}")
  if player_is_playing "${status}"; then
    verb="Pause"
  else
    verb="Play"
  fi

  player="${player}" \
    artist="$(player_tag "${player}" "${status}" artist)" \
    album="$(player_tag "${player}" "${status}" album)" \
    title="$(player_tag "${player}" "${status}" title)" \
    genre="$(player_tag "${player}" "${status}" genre)" \
    verb="${verb}" \
    previous_command="$(player_command "${player}" previous)" \
    toggle_command="$(player_command "${player}" toggle)" \
    stop_command="$(player_command "${player}" stop)" \
    next_command="$(player_command "${player}" next)" \
    display_menu
}

# Doubles `#` so tags can't inject tmux formats like #[...] or #(...)
menu_text() {
  local text="${1:0:60}"
  echo "${text//#/##}"
}

display_menu() {
  tmux display-menu -T "#[fg=cyan]${player}" -x R -y S \
    "" \
    "-Title    #[nodim align=right]$(menu_text "${title}")" "" "" \
    "-Artist   #[nodim align=right]$(menu_text "${artist}")" "" "" \
    "-Album    #[nodim align=right]$(menu_text "${album}")" "" "" \
    "-Genre    #[nodim align=right]$(menu_text "${genre}")" "" "" \
    "" \
    "Previous" "z" "run-shell -b '${previous_command}'" \
    "${verb}" "c" "run-shell -b '${toggle_command}'" \
    "Stop" "v" "run-shell -b '${stop_command}'" \
    "Next" "b" "run-shell -b '${next_command}'" \
    "" \
    "Close" "q" ""
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  music_menu "${@}"
fi
