#!/usr/bin/env bash
# Helper to query beets for albums, select via FZF, then add them to MPD's
# queue and play the first one. MPD names songs relative to its music
# directory, which is beets' directory on the server. Offline (`mpd-offline
# on`) the paths are the same, but only albums synced to this Mac play
#
# Usage:
#
#   # Choose from albums in a given year
#   play-albums year:2025 genre:rock
#
#   # Only add to the end of the queue, without skipping to them
#   play-albums beth gibbons --queue

set -euo pipefail
[[ -n "${TRACE:-}" ]] && set -o xtrace

# shellcheck disable=SC2016
BEET_FORMAT_STRING='$id|$original_year|%left{$albumartist,40}|%left{$album,40}|$genres'
COLUMN_NAMES='ID,Year,Artist,Album,Genres'

FZF_ARGS=(
  --header-lines 1
  --height 80%
  --layout=reverse
  --multi
  -0
  --with-nth 2..
  --accept-nth 1
)

play-albums() {
  local album_ids
  local queue_only=false
  local beet_album_query=()
  local beet_query_args=()
  local beet_query_results
  local music_dir
  local song_paths
  local queue_length

  if ! mpc -q status; then
    exit 1
  fi

  # Parse arguments
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -q | --queue)
        queue_only=true
        shift
        ;;
      *)
        beet_query_args+=("$1")
        shift
        ;;
    esac
  done

  if [[ ${#beet_query_args[@]} -eq 0 ]]; then
    beet_query_args=("added:-4w..")
  fi

  beet_query_results=$(
    beet ls --album --format="${BEET_FORMAT_STRING}" \
      added- albumartist+ original_year- \
      "${beet_query_args[@]}"
  )

  if [[ -z "${beet_query_results}" ]]; then
    echo "No albums found"
    return 1
  fi

  album_ids=$(
    printf '%s\n%s\n' "${COLUMN_NAMES//,/|}" "${beet_query_results}" \
      | column -t -s '|' \
      | fzf "${FZF_ARGS[@]}"
  )

  if [ -z "$album_ids" ]; then
    echo "No albums found"
    return 1
  fi

  for album_id in $album_ids; do
    [[ ${#beet_album_query[@]} -eq 0 ]] || beet_album_query+=(",")
    beet_album_query+=("album_id:${album_id}")
  done

  # `-d` includes beets' default when the config doesn't set it
  music_dir=$(beet config -d | sed -n 's/^directory: //p')

  song_paths=$(beet ls --path original_year- album- disc+ track+ "${beet_album_query[@]}" \
    | sed "s|^${music_dir%/}/||")

  # An empty line would make `mpc add` queue the whole library
  if [[ -z "${song_paths}" ]]; then
    echo "No songs found"
    return 1
  fi

  queue_length=$(mpc status '%length%')
  # mpc reads the paths from stdin when given none
  mpc -q add <<<"${song_paths}"
  printf "Added %d songs\n" "$(wc -l <<<"${song_paths}")"

  if ! ${queue_only}; then
    # Positions count from 1, so this is the first added song
    mpc -q play "$((queue_length + 1))"
  fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  play-albums "$@"
fi
