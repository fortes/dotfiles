cache=${HOME}/.cache/npm
# Install globals to ~/.local/bin so they survive Node upgrades
prefix=${HOME}/.local
# npm comes with Node (script/install_node or brew), so skip self-upgrade nags
update-notifier=false
# Only install versions published 3+ days ago: compromised releases are usually
# pulled within hours. Exempt a package with min-release-age-exclude, or
# override once with --min-release-age=0
min-release-age=3
