#!/usr/bin/env bash
# Dev containers from the dotfiles image (see the README's Containers section).
# Uses Apple's `container` where it's installed, otherwise rootless podman.
#
# Usage:
#   dev              List dev containers
#   dev <name>       Shell in the container, starting it if needed
#   dev create [--shared-state] [--publish <port>]... <name> [image]
#                    Make ~/containers/<name> and its container
#   dev recreate <name> [image]
#                    Replace the container, e.g. for a new image, keeping its
#                    files, logins and ports (and image, unless given)
#
# Mounts ~/containers/<name>/{src,state} at /workspaces and /state (with
# --shared-state, state links to the shared ~/containers/.state), and reads
# ~/containers/<name>/env on every shell. --publish serves a container port on
# the same port on every host interface, so other machines on the LAN can
# reach dev servers that bind to 0.0.0.0.

set -euo pipefail
IFS=$'\n\t'

readonly root="${HOME}/containers"

if command -v container >/dev/null 2>&1; then
  runtime=container
  run_args=()
  # Its service doesn't come back after a reboot or a Homebrew upgrade
  container system status >/dev/null 2>&1 || container system start
else
  runtime=podman
  # Maps the image's UID 1000 user to yours, so mounted files stay yours
  run_args=(--userns=keep-id:uid=1000,gid=1000)
fi

usage() {
  echo "Usage: dev [<name>] | dev create [--shared-state] [--publish <port>]... <name> [image] | dev recreate <name> [image]" >&2
  exit 1
}

# Run container $1 from image $2, with the ports saved for it. --init reaps the
# processes agents' tools leave behind
run_container() {
  local name="$1" image="$2" dir="${root}/$1" port publish=()
  while IFS= read -r port; do
    [[ -n "${port}" ]] || continue
    publish+=(--publish "0.0.0.0:${port}:${port}")
  done <"${dir}/ports"
  # Apple's container already uses the name as the hostname, for the prompt
  local hostname=()
  [[ "${runtime}" == podman ]] && hostname=(--hostname "${name}")
  "${runtime}" run --detach --init --name "${name}" --memory 8G \
    ${run_args[@]+"${run_args[@]}"} ${hostname[@]+"${hostname[@]}"} ${publish[@]+"${publish[@]}"} \
    --volume "${dir}/src:/workspaces" --volume "$(cd "${dir}/state" && pwd -P):/state" \
    "${image}" sleep infinity >/dev/null
}

create() {
  local shared='' ports=() port
  while [[ "${1:-}" == --* ]]; do
    case "$1" in
      --shared-state) shared=1 ;;
      --publish)
        [[ "${2:-}" =~ ^[0-9]+$ ]] || usage
        ports+=("$2")
        shift
        ;;
      *) usage ;;
    esac
    shift
  done
  [[ $# -ge 1 && $# -le 2 ]] || usage
  local name="$1" image="${2:-ghcr.io/fortes/dotfiles:latest}"
  local dir="${root}/${name}"
  if [[ -e "${dir}/image" ]]; then
    echo "${name} already exists; use: dev recreate ${name}" >&2
    exit 1
  fi

  mkdir -p "${dir}/src"
  # Private, since it holds agent logins. A link for shared state, so recreating
  # the container keeps sharing
  if [[ -n "${shared}" ]]; then
    (umask 077 && mkdir -p "${root}/.state"/{claude,codex,antigravity,gemini})
    ln -sfn ../.state "${dir}/state"
  else
    (umask 077 && mkdir -p "${dir}/state"/{claude,codex,antigravity,gemini})
  fi
  if [[ ! -e "${dir}/env" ]]; then
    (
      umask 077
      cat >"${dir}/env" <<'EOF'
# Read by `dev` each time it opens a shell: KEY=value lines, without `export`
# or quotes. Leave the GitHub lines commented out for a container without
# GitHub access. Commits use your identity from ~/.gitconfig.local unless the
# GIT_* lines set the bot's.
# GH_TOKEN=
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# GIT_COMMITTER_NAME=
# GIT_COMMITTER_EMAIL=
# GEMINI_API_KEY=
EOF
    )
  fi
  : >"${dir}/ports"
  for port in ${ports[@]+"${ports[@]}"}; do
    echo "${port}" >>"${dir}/ports"
  done

  # Podman leaves a container behind when its start fails (a port in use)
  "${runtime}" rm --force "${name}" >/dev/null 2>&1 || true
  run_container "${name}" "${image}"
  # Only once it runs, so a failed create (a typo in the image, a port in use)
  # can simply be rerun
  echo "${image}" >"${dir}/image"
  echo "Created ${name}. Add its GitHub token to ${dir}/env if it needs one, then: dev ${name}"
}

# Exit unless `dev create` made container $1
require_container() {
  [[ -e "${root}/$1/image" ]] || {
    echo "No dev container $1; use: dev create $1" >&2
    exit 1
  }
}

list() {
  local dir name
  for dir in "${root}"/*/; do
    name="$(basename "${dir}")"
    [[ -e "${dir}/image" ]] || continue
    printf '%s\t%s\t%s\n' "${name}" "$(cat "${dir}/image")" \
      "$(tr '\n' ' ' <"${dir}/ports")"
  done
}

recreate() {
  local name="$1" image
  require_container "${name}"
  image="${2:-$(cat "${root}/${name}/image")}"
  # Pull the newest from a registry; local builds are already current
  if [[ "${image}" == */* ]]; then
    "${runtime}" image pull "${image}" >/dev/null
  fi
  # It may already be gone
  "${runtime}" rm --force "${name}" >/dev/null 2>&1 || true
  run_container "${name}" "${image}"
  # Only once it runs, so a typo in a new image keeps the old one
  echo "${image}" >"${root}/${name}/image"
  echo "Recreated ${name} from ${image}"
}

shell() {
  local name="$1"
  require_container "${name}"
  # A no-op when it's already running
  "${runtime}" start "${name}" >/dev/null
  # exec resets TERM, so pass through the host tmux's TERM and truecolor
  exec "${runtime}" exec --interactive --tty --env TERM --env COLORTERM \
    --env-file "${root}/${name}/env" --workdir /workspaces "${name}" bash --login
}

case "${1:-}" in
  '') list ;;
  -h | --help) usage ;;
  create)
    shift
    create "$@"
    ;;
  recreate)
    [[ $# -ge 2 && $# -le 3 ]] || usage
    shift
    recreate "$@"
    ;;
  *)
    [[ $# -eq 1 ]] || usage
    shell "$1"
    ;;
esac
