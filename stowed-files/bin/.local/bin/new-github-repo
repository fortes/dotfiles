#!/usr/bin/env bash
# Create a private GitHub repo for agent work: a ruleset on the default branch
# requires a pull request with one approval (dismissed when new commits arrive,
# so it covers what's merged) and blocks force pushes and deletion, and then
# the agent bot is invited with push access. It can push branches and open
# PRs, and merge only what you've approved. Accept the invite as the bot
# afterwards (see README). Rulesets on private repos need GitHub Pro for
# personal accounts.
#
# Usage: new-github-repo <owner/name>, with DOTFILES_AGENT_BOT set to the bot's
# GitHub login (e.g. in ~/.profile.local)

set -euo pipefail
IFS=$'\n\t'

[[ $# -eq 1 ]] || {
  echo "Usage: new-github-repo <owner/name>" >&2
  exit 1
}
repo="$1"
bot="${DOTFILES_AGENT_BOT:?Set DOTFILES_AGENT_BOT to the agent bot GitHub login}"

# With a README, the default branch exists before the ruleset protects it, so
# everything after this goes through pull requests
gh repo create "${repo}" --private --add-readme
gh api --method POST "repos/${repo}/rulesets" --input - >/dev/null <<'EOF'
{
  "name": "Protect default branch",
  "target": "branch",
  "enforcement": "active",
  "conditions": {"ref_name": {"include": ["~DEFAULT_BRANCH"], "exclude": []}},
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false
      }
    }
  ]
}
EOF
# Only once the ruleset exists, so a failure above never leaves the bot with
# push access to an unprotected repo
gh api --method PUT "repos/${repo}/collaborators/${bot}" --field permission=push >/dev/null

echo "Created https://github.com/${repo} and invited ${bot}."
echo "In a container whose env has ${bot}'s token, accept and clone it:"
echo "  gh api user/repository_invitations --jq '.[].id' | xargs -I{} gh api --method PATCH user/repository_invitations/{}"
echo "  git clone https://github.com/${repo}.git"
