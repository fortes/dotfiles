# vim: ft=sh
#
# Point a stable path at the forwarded agent socket so tmux sessions keep
# working across reconnects (see SSH_AUTH_SOCK in tmux.conf). Interactive
# logins take over the link; non-interactive ones (scp, git) only fix a dead
# link, since their socket disappears as soon as they exit.
#
# Note: this file existing stops sshd from running xauth, so X11 forwarding
# won't work unless that is handled here.
SSH_SOCKET_LOCATION="$HOME/.ssh/ssh_auth_sock"

if [ -S "${SSH_AUTH_SOCK}" ] && { [ -n "${SSH_TTY}" ] || [ ! -S "${SSH_SOCKET_LOCATION}" ]; }; then
  ln -sfn "${SSH_AUTH_SOCK}" "${SSH_SOCKET_LOCATION}"
fi
