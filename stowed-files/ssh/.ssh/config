# vim: ft=sshconfig

# Earlier matches take precedence, so this must go first
Include "~/.ssh/config.local"

Host github.com
  User git

Host *
  AddKeysToAgent yes
  # Only offer agent keys that match an IdentityFile, so they don't leak to
  # random hosts. Default ~/.ssh/id_* files are still tried
  IdentitiesOnly yes
