# vim: ft=sshconfig

# Earlier matches take precedence, so this must go first
Include "~/.ssh/config.local"

Host github.com
  User git

# Dev containers (`dev create`): `ssh dev-<name>` goes through the container
# runtime rather than the network, so nothing listens on a port
Host dev-*
  ProxyCommand ~/.local/bin/dev proxy %n
  # The image's user
  User fortes
  # Offer every key: dev trusts them all, and this host is on this machine
  IdentitiesOnly no
  # Agents inside mustn't reach GitHub or servers as you
  ForwardAgent no
  # Kept apart, and `dev rm` forgets a name's key, since names get reused
  UserKnownHostsFile ~/.ssh/known_hosts.dev
  StrictHostKeyChecking accept-new

Host *
  AddKeysToAgent yes
  # Only offer agent keys that match an IdentityFile, so they don't leak to
  # random hosts. Default ~/.ssh/id_* files are still tried
  IdentitiesOnly yes
