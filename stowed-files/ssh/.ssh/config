# vim: ft=sshconfig

# Dev containers (`dev create`): `ssh dev-<name>` goes through the container
# runtime rather than the network, so nothing listens on a port. Not names
# with a dot, which container names never have, so real servers like
# dev-db.example.com stay ordinary hosts (another machine's containers,
# dev-<name>.<host>, get their own block in config.local; see the README).
# Before config.local, since ssh keeps the first value it sees for each
# option: a `Host *` there setting IdentityAgent or ForwardAgent would
# otherwise apply to containers too
Host dev-* !*.*
  ProxyCommand ~/.local/bin/dev proxy %n
  # The image's user
  User fortes
  # dev's own key for its containers, without a passphrase, so apps connect
  # without an agent, Keychain or askpass prompt
  IdentityFile ~/containers/.ssh/client_ed25519
  IdentitiesOnly yes
  IdentityAgent none
  # Agents inside mustn't reach GitHub or servers as you
  ForwardAgent no
  # Kept apart from real hosts; each machine's containers share one host key
  UserKnownHostsFile ~/.ssh/known_hosts.dev
  StrictHostKeyChecking accept-new

# Earlier matches take precedence, so this goes before everything below
Include "~/.ssh/config.local"

Host github.com
  User git

Host *
  AddKeysToAgent yes
  # Only offer agent keys that match an IdentityFile, so they don't leak to
  # random hosts. Default ~/.ssh/id_* files are still tried
  IdentitiesOnly yes
