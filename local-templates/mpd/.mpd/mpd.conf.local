# Server for mpd.conf. script/stow copies this template to ~ once; that copy is
# yours and never tracked.
database {
    plugin "proxy"
    host "REPLACE_ME"
    # Notice connections that died during sleep or a network switch
    keepalive "yes"
}
# Song paths from the server's database, fetched over HTTP(S) from Caddy.
# mpd-sync also gets playlists from here, and beets.db from next to it
music_directory "https://REPLACE_ME/music/"
