# Server for mpd.conf. script/stow copies this template to ~ once; that copy is
# yours and never tracked.
database {
    plugin "proxy"
    host "REPLACE_ME"
    # Notice connections that died during sleep or a network switch
    keepalive "yes"
}
# Song paths from the server's database, fetched over HTTP from Caddy
music_directory "http://REPLACE_ME:8090/music/"
